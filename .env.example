# NetGuard - exemplo de variaveis locais.
# Copie para .env apenas no ambiente local e preencha segredos reais fora do Git.

POSTGRES_USER=netguard
POSTGRES_PASSWORD=
POSTGRES_DB=netguard
DATABASE_URL=postgresql://netguard:CHANGE_ME@db:5432/netguard

GRAFANA_PUBLIC_URL=/grafana
GRAFANA_ROOT_URL=https://netguard.local/grafana/
GRAFANA_ORG_ID=1
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

NETGUARD_PUBLIC_URL=https://netguard.local
NETGUARD_ALERT_TIMEZONE=America/Sao_Paulo
NETGUARD_DEFAULT_USER_PASSWORD=
NETGUARD_AUTH_ENABLED=true
NETGUARD_AUTH_SECRET=
NETGUARD_AUTH_TOKEN_TTL_MINUTES=480
NETGUARD_SERVICE_TOKEN=
NETGUARD_CORS_ORIGINS=https://192.168.56.15,https://netguard.local,https://netguard,https://localhost,https://localhost:8081,https://127.0.0.1:8081,https://192.168.56.15:8081
VITE_API_URL=/api

# Na VM oficial, 192.168.56.20 fica reservado para o emulador de switch Switch Lab.
# Use 192.168.56.1 para o Ollama quando a API roda dentro da VM NetGuard.
OLLAMA_BASE_URL=http://192.168.56.1:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT_SEC=180
OLLAMA_KEEP_ALIVE=10m
OLLAMA_NUM_GPU=0
AI_INSIGHTS_TTL_HOURS=8

POLL_INTERVAL=30
SNMP_INTERVAL_SEC=30
DEFAULT_COLLECTION_TIMEOUT_SEC=1
DEFAULT_COLLECTION_RETRIES=1

AVAILABILITY_ALERTS_ENABLED=true
AVAILABILITY_ICMP_STALE_MULTIPLIER=4
AVAILABILITY_SNMP_STALE_MULTIPLIER=4
AVAILABILITY_SYSLOG_STALE_SEC=300
AVAILABILITY_HOST_DOWN_SAMPLES=2
AVAILABILITY_MIN_STALE_SEC=60
LOOP_RISK_WINDOW_SEC=600
LOOP_RISK_STALE_RESOLVE_SEC=1800
LOOP_RISK_STALE_RESOLVE_NOTIFY=false

HOUSEKEEPER_ENABLED=true
HOUSEKEEPER_INTERVAL_SEC=3600
HOUSEKEEPER_BATCH_ROWS=50000
RETENTION_METRICS_DAYS=30
RETENTION_SYSLOG_DAYS=14
RETENTION_ANOMALY_SCORES_DAYS=30
RETENTION_AI_INSIGHTS_DAYS=30
RETENTION_NOTIFICATIONS_DAYS=180
RETENTION_RESOLVED_INCIDENTS_DAYS=180

ALERT_EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
ALERT_EMAIL_TO=
SMTP_USE_TLS=true

ALERT_WEBHOOK_ENABLED=false
ALERT_CHANNEL_COOLDOWN_SEC=600
WEBHOOK_PROVIDER=discord
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_PARSE_MODE=HTML
TELEGRAM_AI_BOT_ENABLED=true
TELEGRAM_AI_POLL_INTERVAL_SEC=5
TELEGRAM_AI_RESPONSE_TIMEOUT_SEC=180
SLACK_WEBHOOK_URL=
MSTEAMS_WEBHOOK_URL=
GOOGLE_CHAT_WEBHOOK_URL=
MATTERMOST_WEBHOOK_URL=
ROCKETCHAT_WEBHOOK_URL=
PUSHOVER_APP_TOKEN=
PUSHOVER_USER_KEY=
GENERIC_WEBHOOK_URL=
GENERIC_WEBHOOK_HEADERS_JSON=
