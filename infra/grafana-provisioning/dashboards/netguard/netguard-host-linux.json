          "rawSql": "SELECT COALESCE(last_seen_at, opened_at) AS \"Hora\", INITCAP(COALESCE(severity, 'info')) AS \"Severidade\", INITCAP(COALESCE(status, 'open')) AS \"Status\", incident_type AS \"Tipo\", title AS \"Titulo\" FROM incidents WHERE asset_id = ${asset_id} ORDER BY COALESCE(last_seen_at, opened_at) DESC LIMIT 25",
