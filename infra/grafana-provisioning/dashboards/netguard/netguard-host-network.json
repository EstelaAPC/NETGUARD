      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "netguard-postgres"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "WITH filtered AS (\n  SELECT\n    ts,\n    COALESCE(labels->>'ifName', REPLACE(SPLIT_PART(metric, '|', 2), 'ifIndex=', 'ifIndex ')) AS iface,\n    REPLACE(SPLIT_PART(metric, '|', 1), 'snmp.if.', '') AS kind,\n    metric,\n    value,\n    LAG(value) OVER (PARTITION BY metric ORDER BY ts) AS previous_value\n  FROM metrics\n  WHERE $__timeFilter(ts)\n    AND asset_id = ${asset_id}\n    AND (\n      metric LIKE 'snmp.if.in_errors|%'\n      OR metric LIKE 'snmp.if.out_errors|%'\n      OR metric LIKE 'snmp.if.in_discards|%'\n      OR metric LIKE 'snmp.if.out_discards|%'\n    )\n), deltas AS (\n  SELECT\n    ts,\n    iface,\n    kind,\n    CASE WHEN value >= previous_value THEN value - previous_value ELSE 0 END AS delta_value\n  FROM filtered\n  WHERE previous_value IS NOT NULL\n), ranked AS (\n  SELECT iface\n  FROM deltas\n  GROUP BY iface\n  ORDER BY SUM(delta_value) DESC NULLS LAST\n  LIMIT 8\n)\nSELECT ts AS \"time\", iface || ' ' || kind AS metric, delta_value AS value\nFROM deltas\nWHERE iface IN (SELECT iface FROM ranked)\nORDER BY 1, 2",
          "refId": "A"
        }
      ],
      "title": "Erros e descartes por interface",
      "type": "timeseries"
