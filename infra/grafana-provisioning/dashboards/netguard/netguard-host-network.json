          },
          "editorMode": "code",
          "format": "table",
          "rawSql": "WITH latest AS (\n  SELECT\n    REPLACE(key, 'ifIndex=', 'Interface ') AS iface,\n    metric,\n    value,\n    ROW_NUMBER() OVER (PARTITION BY metric, key ORDER BY ts DESC) AS rn\n  FROM anomaly_scores\n  WHERE asset_id = ${asset_id}\n    AND metric IN ('snmp.if.in_octets.delta', 'snmp.if.out_octets.delta')\n), summed AS (\n  SELECT iface, SUM(COALESCE(value, 0)) * 8 AS bits_interval\n  FROM latest\n  WHERE rn = 1\n  GROUP BY iface\n)\nSELECT iface AS metric, bits_interval AS value\nFROM summed\nORDER BY value DESC\nLIMIT 10",
          "refId": "A"
        }
      ],
      "title": "Top interfaces por trafego",
      "type": "bargauge"
