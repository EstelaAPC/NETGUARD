      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "netguard-postgres"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "WITH filtered AS (\n  SELECT\n    ts,\n    COALESCE(labels->>'ifName', REPLACE(SPLIT_PART(metric, '|', 2), 'ifIndex=', 'ifIndex ')) AS iface,\n    metric,\n    value,\n    LAG(value) OVER (PARTITION BY metric ORDER BY ts) AS previous_value,\n    EXTRACT(EPOCH FROM ts - LAG(ts) OVER (PARTITION BY metric ORDER BY ts)) AS seconds\n  FROM metrics\n  WHERE $__timeFilter(ts)\n    AND asset_id = ${asset_id}\n    AND metric LIKE 'snmp.if.in_octets|%'\n), rates AS (\n  SELECT\n    ts,\n    iface,\n    CASE\n      WHEN seconds > 0 AND value >= previous_value THEN ((value - previous_value) * 8) / seconds\n      ELSE NULL\n    END AS bps\n  FROM filtered\n)\nSELECT ts AS \"time\", iface AS metric, bps AS value\nFROM rates\nWHERE bps IS NOT NULL\n  AND iface IN (\n    SELECT iface\n    FROM rates\n    GROUP BY iface\n    ORDER BY MAX(bps) DESC NULLS LAST\n    LIMIT 8\n  )\nORDER BY 1, 2",
          "refId": "A"
        }
      ],
      "title": "Trafego de entrada por interface",
      "type": "timeseries"
    },
