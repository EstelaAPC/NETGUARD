        {
          "datasource": {
            "type": "postgres",
            "uid": "netguard-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawSql": "WITH latest AS (\n  SELECT\n    COALESCE(labels->>'ifName', REPLACE(SPLIT_PART(metric, '|', 2), 'ifIndex=', 'ifIndex ')) AS iface,\n    REPLACE(SPLIT_PART(metric, '|', 1), 'snmp.if.', '') AS item,\n    value,\n    ts,\n    ROW_NUMBER() OVER (PARTITION BY metric ORDER BY ts DESC) AS rn\n  FROM metrics\n  WHERE asset_id = ${asset_id}\n    AND metric LIKE 'snmp.if.%|%'\n), pivoted AS (\n  SELECT\n    iface,\n    MAX(CASE WHEN item = 'admin_status' THEN value END) AS admin_status,\n    MAX(CASE WHEN item = 'oper_status' THEN value END) AS oper_status,\n    MAX(CASE WHEN item = 'in_octets' THEN value END) AS in_octets,\n    MAX(CASE WHEN item = 'out_octets' THEN value END) AS out_octets,\n    MAX(CASE WHEN item = 'in_errors' THEN value END) AS in_errors,\n    MAX(CASE WHEN item = 'out_errors' THEN value END) AS out_errors,\n    MAX(CASE WHEN item = 'in_discards' THEN value END) AS in_discards,\n    MAX(CASE WHEN item = 'out_discards' THEN value END) AS out_discards,\n    MAX(ts) AS last_sample\n  FROM latest\n  WHERE rn = 1\n  GROUP BY iface\n)\nSELECT\n  iface AS \"Interface\",\n  CASE admin_status WHEN 1 THEN 'UP' WHEN 2 THEN 'DOWN' WHEN 3 THEN 'TESTING' ELSE COALESCE(admin_status::text, '-') END AS \"Admin\",\n  CASE oper_status WHEN 1 THEN 'UP' WHEN 2 THEN 'DOWN' WHEN 3 THEN 'TESTING' WHEN 4 THEN 'UNKNOWN' WHEN 5 THEN 'DORMANT' WHEN 6 THEN 'NOT PRESENT' WHEN 7 THEN 'LOWER LAYER DOWN' ELSE COALESCE(oper_status::text, '-') END AS \"Oper\",\n  ROUND(COALESCE(in_octets, 0)::numeric, 0) AS \"In octets\",\n  ROUND(COALESCE(out_octets, 0)::numeric, 0) AS \"Out octets\",\n  ROUND(COALESCE(in_errors, 0)::numeric, 0) AS \"In errors\",\n  ROUND(COALESCE(out_errors, 0)::numeric, 0) AS \"Out errors\",\n  ROUND(COALESCE(in_discards, 0)::numeric, 0) AS \"In discards\",\n  ROUND(COALESCE(out_discards, 0)::numeric, 0) AS \"Out discards\",\n  last_sample AS \"Ultima coleta\"\nFROM pivoted\nORDER BY COALESCE(in_octets, 0) + COALESCE(out_octets, 0) DESC\nLIMIT 24",
          "refId": "A"
        }
      ],
      "title": "Interfaces - snapshot SNMP",
      "type": "table"
